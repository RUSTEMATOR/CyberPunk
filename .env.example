BOT_TOKEN=
ANTHROPIC_API_KEY=
ADMIN_IDS=
GROUP_CHAT_ID=
DB_PATH=data/game.db
TIMEZONE=Europe/Kyiv
MONTHLY_BUDGET_USD=100
MODEL_NARRATIVE=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5
# Prices in USD per 1M tokens (checked against the pricing page in October 2026: Sonnet 5.5 and Haiku 5.5 up to 100k tokens).
# The budget counter uses them; with empty prices it counts zero and the 90% switch never fires.
PRICE_NARRATIVE_IN=2
PRICE_NARRATIVE_OUT=10
PRICE_FAST_IN=0.1
PRICE_FAST_OUT=0.5
# Cache price as a multiple of the input price: a write costs 1.25x. A read costs 0.05x on Sonnet and 0.1x on Haiku;
# one value serves both, 0.1 slightly overstates Sonnet (safe for a budget).
PRICE_CACHE_WRITE_MULT=1.25
PRICE_CACHE_READ_MULT=0.1
LLM_ENABLED=true
